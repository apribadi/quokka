use crate::token::Token;
use crate::ast::Op1;
use crate::ast::Op2;
use crate::ast::Expr;
use crate::ast::IncDec;
use crate::ast::PrePost;
use crate::ast::Stmt;

grammar<'a>(source: &'a str);

pub STMT: Stmt<'a> = {
  LET SYMBOL EQUAL <x:EXPR> =>
    Stmt::Let(Box::new((vec![].into_boxed_slice(), vec![].into_boxed_slice()))),
  <x:EXPR_1> LBRACKET_ATTACHED <y:EXPR> RBRACKET EQUAL <z:EXPR> =>
    Stmt::SetIndex(Box::new((x, y, z))),
  <s:SYMBOL> EQUAL <x:EXPR> =>
    Stmt::SetLocal(Box::new((s, x))),
  CONTINUE => Stmt::Continue,
  EXPR => Stmt::ExprList(vec![<>].into_boxed_slice()),
}

BLOCK: Box<[(Stmt<'a>)]> = {
  RBRACE => Box::from([]),
  <x:STMT> RBRACE => Box::from([x]),
  <x:STMT> <y:STMT> RBRACE => Box::from([x, y]),
}

EXPR_LIST: Box<[Expr<'a>]> = {
  COMMA_SEPARATED_LIST<EXPR>
}

EXPR: Expr<'a> = {
  EXPR_7,
}

EXPR_0: Expr<'a> = {
  <s:SYMBOL> => Expr::Var(s),
  <x:INT> => Expr::ConstI64(x),
  FALSE => Expr::ConstBool(false),
  TRUE => Expr::ConstBool(true),
  LPAREN <x:EXPR> RPAREN => x,
}

EXPR_1: Expr<'a> = {
  EXPR_0,
  <x:EXPR_1> DOT_ATTACHED <s:SYMBOL_ATTACHED> => Expr::GetField(Box::new((x, s))),
  <x:EXPR_1> LBRACKET_ATTACHED <y:EXPR> RBRACKET => Expr::GetIndex(Box::new((x, y))),
  <x:EXPR_1> LPAREN_ATTACHED <y:EXPR_LIST> RPAREN => Expr::Call(Box::new((x, y))),
}

EXPR_2: Expr<'a> = {
  EXPR_1,
  LOOP LBRACE <x:BLOCK> => Expr::Loop(x),
}

EXPR_3: Expr<'a> = {
  EXPR_2,
  INC <s:SYMBOL> => Expr::IncDecLocal(Box::new((PrePost::Pre, IncDec::Inc, s))),
  DEC <s:SYMBOL> => Expr::IncDecLocal(Box::new((PrePost::Pre, IncDec::Dec, s))),
  SUB <x:EXPR_3> => Expr::Op1(Box::new((Op1::Neg, x))),
  NOT <x:EXPR_3> => Expr::Op1(Box::new((Op1::Not, x))),
}

EXPR_4: Expr<'a> = {
  EXPR_3,
  <s:SYMBOL> INC => Expr::IncDecLocal(Box::new((PrePost::Post, IncDec::Inc, s))),
  <s:SYMBOL> DEC => Expr::IncDecLocal(Box::new((PrePost::Post, IncDec::Dec, s))),
}

EXPR_5: Expr<'a> = {
  EXPR_4,
  <x:EXPR_5> MUL <y:EXPR_4> => Expr::Op2(Box::new((Op2::Mul, x, y))),
  <x:EXPR_5> DIV <y:EXPR_4> => Expr::Op2(Box::new((Op2::Div, x, y))),
}

EXPR_6: Expr<'a> = {
  EXPR_5,
  <x:EXPR_6> ADD <y:EXPR_5> => Expr::Op2(Box::new((Op2::Add, x, y))),
  <x:EXPR_6> SUB <y:EXPR_5> => Expr::Op2(Box::new((Op2::Sub, x, y))),
}

EXPR_7: Expr<'a> = {
  EXPR_6,
  <x:EXPR_7> SHL <y:EXPR_6> => Expr::Op2(Box::new((Op2::Shr, x, y))),
  <x:EXPR_7> SHR <y:EXPR_6> => Expr::Op2(Box::new((Op2::Shl, x, y))),
}

LPAREN = { LPAREN_ATTACHED, LPAREN_DETACHED, }

LBRACKET = { LBRACKET_ATTACHED, LBRACKET_DETACHED, }

SYMBOL: &'a str = { SYMBOL_ATTACHED, SYMBOL_DETACHED, }

SEPARATED_LIST_AUX<T, U>: Vec<T> = {
  <x:T> => vec![x],
  <x:SEPARATED_LIST_AUX<T, U>> U <y: T> => { let mut x = x; x.push(y); x },
}

COMMA_SEPARATED_LIST<T>: Box<[T]> = {
  <x: SEPARATED_LIST_AUX<T, COMMA>> => x.into_boxed_slice(),
}

LIST_AUX<T>: Vec<T> = {
  <x:T> => vec![x],
  <x:LIST_AUX<T>> <y: T> => { let mut x = x; x.push(y); x },
}

extern {
  type Location = usize;
  
  type Error = ();

  enum Token<'a> {
    NOT => Token::Not,
    DOLLAR => Token::Dollar,
    REM => Token::Rem,
    BIT_AND => Token::BitAnd,
    LPAREN_ATTACHED => Token::LParen(true),
    LPAREN_DETACHED => Token::LParen(false),
    RPAREN => Token::RParen,
    MUL => Token::Mul,
    ADD => Token::Add,
    COMMA => Token::Comma,
    SUB => Token::Sub,
    DOT_ATTACHED => Token::Dot(true),
    DOT_DETACHED => Token::Dot(false),
    DIV => Token::Div,
    COLON => Token::Colon,
    CMP_LT => Token::CmpLt,
    EQUAL => Token::Equal,
    CMP_GT => Token::CmpGt,
    Query => Token::Query,
    AT => Token::At,
    LBRACKET_ATTACHED => Token::LBracket(true),
    LBRACKET_DETACHED => Token::LBracket(false),
    RBRACKET => Token::RBracket,
    BIT_XOR => Token::BitXor,
    UNDERSCORE => Token::Underscore,
    LBRACE => Token::LBrace,
    BIT_OR => Token::BitOr,
    RBRACE => Token::RBrace,
    TILDE => Token::Tilde,
    SHL => Token::Shl,
    SHR => Token::Shr,
    LOG_AND => Token::LogAnd,
    LOG_OR => Token::LogOr,
    INC => Token::Inc,
    DEC => Token::Dec,
    CMP_EQ => Token::CmpEq,
    CMP_NE => Token::CmpNe,
    CMP_LE => Token::CmpLe,
    CMP_GE => Token::CmpGe,
    DOT_DOT_DOT => Token::DotDotDot,
    BREAK => Token::Break,
    CONTINUE => Token::Continue,
    DO => Token::Do,
    ELIF => Token::Elif,
    ELSE => Token::Else,
    FALSE => Token::False,
    FOR => Token::For,
    FUN => Token::Fun,
    IF => Token::If,
    LET => Token::Let,
    LOOP => Token::Loop,
    MUTABLE => Token::Mutable,
    RETURN => Token::Return,
    TRUE => Token::True,
    WHILE => Token::While,
    SYMBOL_ATTACHED => Token::Symbol((true, <&'a str>)),
    SYMBOL_DETACHED => Token::Symbol((false, <&'a str>)),
    INT => Token::Int(<i64>),
  }
}
